# Public Supabase client config (safe to commit: the publishable key is meant for browsers;
# Row Level Security on every table protects the data). Used only by production builds —
# dev, tests and e2e keep using the local offline adapter.
# NOTE: because of this file, a local `npm run build` / `npm run preview` talks to the LIVE
# project. Repository secrets of the same names override it in the deploy workflow; to build
# without a server, run `npx vite build --mode offline` (see docs/ONLINE.md, step 4).
# Never put a service-role / sb_secret key or the database password here.
VITE_SUPABASE_URL=https://xbyhwxkhldgbvclpqdfq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_G_YeoTz9XUGclmPn4xC0jQ_OvNfZ3Ri
