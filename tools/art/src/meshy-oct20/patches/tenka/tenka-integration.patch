+def normalize(arm, hi, height=1.7, recentre=True, centre_bones=('Hips', 'Head')):
+    """Bring an API-rigged Meshy figure into the tool's working space (the owner's Hikari export:
+    unit-scale armature, feet at z = 0, 1.7 tall, body centre line on x = 0):
+
+    * the Meshy API GLB has Armature scale 0.01 (cm bones): applied into the bones and the mesh,
+      otherwise the packed node scale breaks the runtime outline / depth push
+    * scaled to `height` (Tenka is 0.9 m), so FACE_BOX, bake cage / ray and the eye windows,
+      all written for 1.7 m, keep their meaning
+    * her body centre line (mean x of `centre_bones`) moved to x = 0: the API rig of a figure
+      with a side ponytail is not centred, and the eye finder / blink split her eyes at x = 0
+    Returns the factors applied."""
+    sel = [arm] + [o for o in bpy.data.objects if o.type == 'MESH' and o.parent == arm] + ([hi] if hi.parent != arm else [])
+    bpy.context.view_layer.update()
+
+    def apply(loc=False):
+        for o in bpy.data.objects:
+            o.select_set(o in sel)
+        bpy.context.view_layer.objects.active = arm
+        bpy.ops.object.transform_apply(location=loc, rotation=False, scale=True)
+        bpy.context.view_layer.update()
+
+    s0 = tuple(arm.scale)
+    apply()
+    zs = np.array([(hi.matrix_world @ v.co).z for v in hi.data.vertices])
+    k = height / float(zs.max() - zs.min()) if height else 1.0
+    dx = 0.0
+    if recentre:
+        dx = -float(np.mean([(arm.matrix_world @ arm.data.bones[n].head_local).x for n in centre_bones if n in arm.data.bones]))
+    arm.scale = (k, k, k)
+    arm.location = (dx * k, 0.0, -float(zs.min()) * k)
+    bpy.context.view_layer.update()
+    apply(loc=True)
+    zs = np.array([(hi.matrix_world @ v.co).z for v in hi.data.vertices])
+    out = dict(armature_scale=[round(x, 5) for x in s0], k=round(k, 5), dx=round(dx * k, 5),
+               height=round(float(zs.max() - zs.min()), 4), floor=round(float(zs.min()), 5))
+    print(f'[meshy] normalised: {out}')
+    return out
+
