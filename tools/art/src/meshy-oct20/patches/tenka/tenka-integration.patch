+    POLE_L = lambda M: M['upper_arm_L'].translation + V((0.30, 0.30, -0.25))  # noqa: E731
+    ARM_L_ABDUCT = E(y=-7.0)
+    TORSO_OFF = lambda M: M['chest'].translation - rig.head['chest']  # noqa: E731
+
+    def hold_arm(M0, T=None, B=None, U=None, k_off=0.8):
