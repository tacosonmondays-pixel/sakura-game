@@ -0,0 +1,379 @@
+"""Tenka's game clips on her Meshy API rig (24-bone humanoid + a floor 'root') and the socket of
+her coilgun.
+
+The coilgun is its own GLB (tools/meshy/build_meshy_prop.py -> <unit>-coilgun.glb). Her GLB only
+carries an empty node 'prop_coilgun' on hand_R: the gun's own frame (barrel -X, top +Y, grip
+centre GRIP_LOCAL) placed in her right fist with the barrel along the forearm and the top on the
+thumb side, scaled so the gun is GUN_OF_HEIGHT of her height. The runtime hangs the prop file's
+mesh under that node (asset.extras.props), so every clip moves the gun with her hand.
+
+Clips (30 fps, keyed on every frame, world-axis rotations on top of the rest pose, posekit):
+  idle        1.5 s  library idle (torso, head, free arm) + two soft knee bounces; the gun held
+                     low at her right hip, barrel forward and down, cells up
+  walk        0.97 s library walk, gun held low and swinging a little with the step
+  attack_rifle 0.6 s quick-draw: the gun is up and aimed straight ahead by 0.07 s, two recoil kicks
+                     (0.08 s and 0.22 s; she is a rapid shooter and the battle restarts the clip at
+                     most every 0.45 s), held on aim, back to the low hold by 0.6 s
+  cheer       1.2 s  hop with the coilgun raised high (barrel up) and a left fist pump
+  hurt        0.4 s  flinch back, gun arm pulled in
+Every clip carries the chin-up lean CHIN (spine + neck + head, total CHIN_TOTAL deg) so her eyes
+clear her bangs from the 48 deg battle camera. No hair / coat bones: the ponytail is rigid.
+The gun arm is 2-bone IK with a full hand orientation (barrel + top) solved per frame, half of
+the forearm-hand twist given to the forearm so the wrist never candy-wraps."""
+import math
+
+import bpy
+import numpy as np
+from mathutils import Matrix, Quaternion, Vector
+
+from .posekit import Rig, E, rotq, smooth, lerp, two_bone
+
+CLIPS = ('idle', 'walk', 'attack_rifle', 'cheer', 'hurt')
+PROP_SOCKET = 'prop_coilgun'
+# the coilgun mesh's own frame (Meshy units, glTF axes): barrel -X, top +Y, 1.90 long; centre of
+# the grip where her fist closes. In Blender axes (what the socket's matrix maps): barrel -X,
+# top +Z, glTF +Z -> -Y.
+GRIP_LOCAL = Vector((0.58, -0.35, 0.0))
+GRIP_LOCAL_B = Vector((GRIP_LOCAL.x, -GRIP_LOCAL.z, GRIP_LOCAL.y))
+GUN_LENGTH_LOCAL = 1.90
+GUN_OF_HEIGHT = 0.24
+# chin-up lean (deg, negative = chin up): spine, neck, head
+CHIN = dict(spine=-3.0, neck=-6.0, head=-5.0)
+CHIN_TOTAL = -sum(CHIN.values())
+
+
+def palm_centre(arm, mesh, bone='hand_R', min_w=0.6):
+    """Centroid of the mesh vertices mostly weighted to the hand bone (her mitten fist)."""
+    vg = mesh.vertex_groups.get(bone)
+    if vg is None:
+        return None
+    pts = []
+    for v in mesh.data.vertices:
+        for g in v.groups:
+            if g.group == vg.index and g.weight >= min_w:
+                pts.append((mesh.matrix_world @ v.co)[:])
+                break
+    return Vector(np.mean(np.array(pts), 0)) if pts else None
+
+
+def build(arm, mesh, raw_fps=24, fps=30, height=1.7, socket_name=PROP_SOCKET):
+    """Adds the coilgun socket (an empty on hand_R) and the game actions; removes the raw_*
+    actions. Returns (objects to export with her, info for asset.extras)."""
+    FPS = fps
+    sc = bpy.context.scene
+    sc.render.fps = FPS
+    rig = Rig(arm)
+    V = Vector
+
+    if arm.animation_data:
+        arm.animation_data.action = None
+    for pb in arm.pose.bones:
+        pb.rotation_mode = 'QUATERNION'
+        pb.rotation_quaternion = (1, 0, 0, 0); pb.location = (0, 0, 0); pb.scale = (1, 1, 1)
+    sc.frame_set(0)
+    bpy.context.view_layer.update()
+
+    # ---------------------------------------------------------------- the gun in her fist (rest pose)
+    wr = rig.head['hand_R']
+    el = rig.head['forearm_R']
+    fa_dir = (wr - el).normalized()                      # rest forearm axis (down and out)
+    palm = palm_centre(arm, mesh) or (wr + fa_dir * 0.045 * height)
+    # top of the gun on the thumb side: her A-pose hand hangs with the thumb forward (-Y)
+    up_rest = (V((0, -1, 0)) - fa_dir * fa_dir.dot(V((0, -1, 0)))).normalized()
+    barrel_rest = fa_dir
+
+    def frame(barrel, top):
+        """Rotation taking the prop's Blender-local axes to world: barrel (-X) along `barrel`, top (+Z) toward `top`."""
+        b = barrel.normalized()
+        t = (top - b * top.dot(b)).normalized()
+        xb = -b; zb = t; yb = zb.cross(xb).normalized()
+        return Matrix((xb, yb, zb)).transposed()
+    G0 = frame(barrel_rest, up_rest)                       # gun local -> world at rest
+    G0q = G0.to_quaternion()
+    s = GUN_OF_HEIGHT * height / GUN_LENGTH_LOCAL
+    gun_pos = palm - (G0 @ GRIP_LOCAL_B) * s
+    sock = bpy.data.objects.new(socket_name, None)
+    sock.empty_display_type = 'ARROWS'
+    sc.collection.objects.link(sock)
+    Mw = Matrix.Translation(gun_pos) @ G0.to_4x4() @ Matrix.Scale(s, 4)
+    sock.matrix_world = Mw
+    sock.parent = arm; sock.parent_type = 'BONE'; sock.parent_bone = 'hand_R'
+    sock.matrix_world = Mw
+    bpy.context.view_layer.update()
+    print(f'[tenka] coilgun socket: scale {s:.4f}, palm {tuple(round(x, 3) for x in palm)}, barrel {tuple(round(x, 3) for x in barrel_rest)}')
+
+    def gun_rot(barrel, top):
+        """World delta of hand_R that points the gun's barrel along `barrel` with its top toward `top`."""
+        return frame(barrel, top).to_quaternion() @ G0q.inverted()
+
+    # ---------------------------------------------------------------- raw clip samplers
+    def sample_raw(name):
+        act = bpy.data.actions[name]; arm.animation_data.action = act
+        f0, f1 = int(act.frame_range[0]), int(act.frame_range[1])
+        frames = []
+        for f in range(f0, f1 + 1):
+            sc.frame_set(f)
+            D = {n: rotq(arm.pose.bones[n].matrix) @ rig.Rq[n].inverted() for n in rig.order}
+            L = {}
+            for n in rig.order:
+                p = rig.parent[n]
+                L[n] = D[n] if p is None else D[p].inverted() @ D[n]
+            rt = arm.pose.bones['hips'].matrix.translation - rig.head['hips']
