+        return out
+
+    raw_idle, raw_idle_len = sample_raw('raw_idle')
+    raw_walk, raw_walk_len = sample_raw('raw_walk')
+    raw_idle = looped(raw_idle); raw_walk = looped(raw_walk, 0.10)
+    print('[tenka] raw lengths', raw_idle_len, raw_walk_len)
+
+    TORSO = ['hips', 'spine', 'spine1', 'chest', 'neck', 'head']
+    ARM_L = ['shoulder_L', 'upper_arm_L', 'forearm_L', 'hand_L']
+    LEGS = ['thigh_L', 'shin_L', 'foot_L', 'toe_L', 'thigh_R', 'shin_R', 'foot_R', 'toe_R']
+
+    # ---------------------------------------------------------------- IK
+    LEN = {}
+    for sd in 'LR':
+        LEN['arm' + sd] = ((rig.head['forearm_' + sd] - rig.head['upper_arm_' + sd]).length, (rig.head['hand_' + sd] - rig.head['forearm_' + sd]).length)
+        LEN['leg' + sd] = ((rig.head['shin_' + sd] - rig.head['thigh_' + sd]).length, (rig.head['foot_' + sd] - rig.head['shin_' + sd]).length)
+    ARM_LEN = sum(LEN['armR'])
+    SH_R = rig.head['upper_arm_R'].copy()
+    SH_L = rig.head['upper_arm_L'].copy()
+    print(f'[tenka] arm length {ARM_LEN:.3f}, shoulder R {tuple(round(x, 3) for x in SH_R)}')
+
+    def arm_ik(M, ov, sd, T, pole, hand=None, twist_share=0.5):
+        """2-bone IK to T (hand head); hand = absolute world delta of the hand bone (or None:
+        the hand follows the forearm). Half the hand's twist about the forearm goes to the forearm."""
+        ua, fa, hd = 'upper_arm_' + sd, 'forearm_' + sd, 'hand_' + sd
+        S = M[ua].translation
+        L1, L2 = LEN['arm' + sd]
+        Ep, Tp = two_bone(S, L1, L2, T, pole)
+        r_ua = rig.head[fa] - rig.head[ua]
+        r_fa = rig.head[hd] - rig.head[fa]
+        Dua = r_ua.rotation_difference(Ep - S)
+        Dfa = r_fa.rotation_difference(Tp - Ep)
+        if hand is not None:
+            # twist of the hand relative to the forearm, about the forearm's rest axis
+            rel = Dfa.inverted() @ hand
+            ax = r_fa.normalized()
+            v = Vector((rel.x, rel.y, rel.z))
+            proj = ax * v.dot(ax)
+            tw = Quaternion((rel.w, proj.x, proj.y, proj.z))
+            if tw.magnitude > 1e-8:
+                tw.normalize()
+                ang = 2 * math.atan2(Vector((tw.x, tw.y, tw.z)).dot(ax), tw.w)
+                Dfa = Dfa @ Quaternion(ax, ang * twist_share)
+            ov[hd] = hand
+        else:
+            ov[hd] = Dfa
+        ov[ua] = Dua; ov[fa] = Dfa
+
+    def leg_ik(M, ov, sd, T):
+        th, sh, ft = 'thigh_' + sd, 'shin_' + sd, 'foot_' + sd
+        S = M[th].translation
+        L1, L2 = LEN['leg' + sd]
+        pole = S + V((0.04 if sd == 'L' else -0.04, -0.6, -0.15))
+        Ep, Tp = two_bone(S, L1, L2, T, pole)
+        ov[th] = (rig.head[sh] - rig.head[th]).rotation_difference(Ep - S)
+        ov[sh] = (rig.head[ft] - rig.head[sh]).rotation_difference(Tp - Ep)
+        ov[ft] = Quaternion()
+
+    def pose(L, root_t, arms=None, legs=True, foot_lift=(0.0, 0.0)):
+        M, D = rig.solve(L, root_t)
+        ov = {}
+        if legs:
+            for i, sd in enumerate('LR'):
+                leg_ik(M, ov, sd, rig.head['foot_' + sd] + V((0, 0, foot_lift[i])))
+        for sd, spec in (arms or {}).items():
+            arm_ik(M, ov, sd, **spec)
