+
+    def lean(L, k=1.0):
+        for b, deg in CHIN.items():
+            L[b] = E(x=deg * k) @ L.get(b, Quaternion())
+
+    def keyframes(name, n_frames, fn):
+        act = bpy.data.actions.new(name); act.use_fake_user = True
+        arm.animation_data.action = act
+        for f in range(n_frames + 1):
+            M, D = fn(f / FPS)
+            rig.key(M, f)
+        arm.animation_data.action = None
+        return act
+
+    def scalar_keys(keys, t):
+        if t <= keys[0][0]: return keys[0][1]
+        if t >= keys[-1][0]: return keys[-1][1]
+        for i in range(len(keys) - 1):
+            if keys[i][0] <= t <= keys[i + 1][0]:
+                u = smooth((t - keys[i][0]) / (keys[i + 1][0] - keys[i][0]))
+                return lerp(keys[i][1], keys[i + 1][1], u)
+
+    def vec_keys(keys, t):
+        if t <= keys[0][0]: return keys[0][1].copy()
+        if t >= keys[-1][0]: return keys[-1][1].copy()
+        for i in range(len(keys) - 1):
+            if keys[i][0] <= t <= keys[i + 1][0]:
+                u = smooth((t - keys[i][0]) / (keys[i + 1][0] - keys[i][0]))
+                return keys[i][1].lerp(keys[i + 1][1], u)
+
+    # ---------------------------------------------------------------- shared poses (relative to her right shoulder)
+    # low hold: fist beside her right hip, a little forward; barrel forward-down, the gun rolled
+    # so its top (cells, coils) faces out and its side profile faces the 48 deg battle camera
+    # (thumb-up it showed the camera only its top and read as a canister)
+    HOLD_T = SH_R + V((-0.060, -0.100, -0.235))
