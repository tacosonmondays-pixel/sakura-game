@@ -0,0 +1,88 @@
+"""A Meshy-made hand prop as its own phone-packed GLB (Tenka's coilgun):
+
+    python3 tools/meshy/build_meshy_prop.py --source <tenka-coilgun Meshy GLB> --id tenka-coilgun --unit tenka
+
+The prop keeps its own frame (Meshy units: the coilgun is 1.9 long, barrel -X, top +Y): the
+figure's GLB carries the socket node that places and scales that frame in her fist
+(lib/clips_tenka.py, asset.extras.props), and the runtime hangs this file's mesh under it.
+Same steps as the figure (lib/lowpoly.py, lib/bake.py, lib/pack.py): weld, decimate to --tris,
+fresh xatlas UVs, Cycles bakes of the base colour (at --tex, shipped at --ship-tex) and the
+metal/roughness map (the copper coils are metallic), phone packing at the figure's half-size
+storage so the socket's scale applies unchanged. One file serves both detail levels.
+Needs bpy 4.2, numpy, Pillow and xatlas."""
+import argparse
+import os
+import sys
+import tempfile
+import time
+
+import bpy
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+sys.path.insert(0, HERE)
+
+from lib import lowpoly, bake, pack  # noqa: E402
+
+STORE_SCALE = 0.5  # the figure's storage scale (build_meshy_chibi.py): the socket scale is relative to it
+
+
+def main():
+    argv = sys.argv[sys.argv.index('--') + 1:] if '--' in sys.argv else sys.argv[1:]
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--source', required=True, help='the Meshy prop GLB')
+    ap.add_argument('--id', required=True, help='file id, e.g. tenka-coilgun')
+    ap.add_argument('--unit', required=True, help='the figure that holds it')
+    ap.add_argument('--socket', default=None, help='socket node name in the figure (default prop_<id after the unit>)')
+    ap.add_argument('--out', default=os.path.join(ROOT, 'public', 'models', 'characters'))
+    ap.add_argument('--tris', type=int, default=3000)
+    ap.add_argument('--tex', type=int, default=1024)
+    ap.add_argument('--ship-tex', type=int, default=512)
+    ap.add_argument('--mr-tex', type=int, default=256)
+    ap.add_argument('--webp-quality', type=int, default=90)
+    args = ap.parse_args(argv)
+    t0 = time.time()
+    lowpoly.FACE_BOX = dict(zmin=1e9, zmax=-1e9, xmax=0.0, ymax=-1e9)  # no face on a prop
+    lowpoly.PROTECT = []
+    bpy.ops.wm.read_factory_settings(use_empty=True)
+    bpy.ops.import_scene.gltf(filepath=args.source)
+    meshes = [o for o in bpy.data.objects if o.type == 'MESH']
+    hi = max(meshes, key=lambda o: len(o.data.vertices))
+    hi.name = 'hi'
+    # bake in the prop's own frame: no object transform left on the source
+    for o in bpy.data.objects:
+        o.select_set(o == hi)
+    bpy.context.view_layer.objects.active = hi
+    bpy.ops.object.parent_clear(type='CLEAR_KEEP_TRANSFORM')
+    bpy.ops.object.transform_apply(location=True, rotation=True, scale=True)
+    lo = lowpoly.make_lowpoly(hi, args.tris)
+    uv = lowpoly.unwrap_xatlas(lo, face_scale=1.0, resolution=args.tex, padding=4)
+    tmp = tempfile.mkdtemp(prefix='prop_')
+    bake.bake_maps(hi, lo, tmp, args.tex, mr_res=args.mr_tex, normal_res=0, cage=0.01, ray=0.03)
+    bpy.data.objects.remove(hi)
+    for o in list(bpy.data.objects):
+        if o != lo:
+            bpy.data.objects.remove(o)
+    lo.name = lo.data.name = args.id
+    for o in bpy.data.objects:
+        o.select_set(o == lo)
+    raw = os.path.join(tmp, 'raw.glb')
+    bpy.ops.export_scene.gltf(filepath=raw, export_format='GLB', use_selection=True, export_animations=False, export_skins=False,
+                              export_normals=True, export_texcoords=True, export_image_format='AUTO', export_yup=True,
+                              export_extras=False)
+    socket = args.socket or f'prop_{args.id[len(args.unit) + 1:] if args.id.startswith(args.unit + "-") else args.id}'
+    zs = [v.co.z for v in lo.data.vertices]
+    extras = dict(unit=args.unit, prop=args.id, socket=socket, source='meshy', style='textured-prop', storeScale=STORE_SCALE,
+                  frame=dict(barrel='-X', top='+Y'), generator='tools/meshy/build_meshy_prop.py')
+    out = os.path.join(args.out, f'{args.id}.glb')
+    pack.pack(raw, out, STORE_SCALE, extras, webp_quality=args.webp_quality, tex_size=args.ship_tex)
+    js, _ = pack.read_glb(out)
+    tri = sum(js['accessors'][p['indices']]['count'] // 3 for m in js['meshes'] for p in m['primitives'])
+    print(f'[meshy-prop] {args.id}: {os.path.getsize(out) // 1024} KB, {tri} tris, {uv["charts"]} charts, '
+          f'tex {args.ship_tex} (baked {args.tex}), height {max(zs) - min(zs):.3f}, {time.time() - t0:.1f}s')
+
+
+if __name__ == '__main__':
+    main()
+    sys.stdout.flush()
+    os._exit(0)
