+"""Per-figure settings of the Meshy import (tools/meshy/build_meshy_chibi.py --profile <id>).
+
+The tool was written for one figure (the owner's Hikari export: SmartRig bones, 1.7 m, teal eyes,
+pink hair). Everything figure-specific lives here; 'hikari' reproduces the original build exactly.
+
+Keys:
+  normalize   None, or dict(height, recentre): apply the armature scale (Meshy API rigs carry a
+              0.01 Armature scale), scale to the working height and centre the body on x = 0
+  face_box    the face window at the working height (Blender axes: -Y is her front, Z up):
+              decimation guard, 2x texel density, flat skin normals, eye search
+  protect     extra decimation guards [(zmin, zmax, xmax, ymax, weight)]
+  hair        her hair colour test on sRGB bytes (r, g, b int16 arrays) -> bool array: kept out of
+              the flat-normal mask, the eye boxes and (as hair_guard) the shader's closed eyes
+  iris        her iris colour test (same signature)
+  eye_front   only texels in front of this y count for the eyes
+  eye_win     the eye search window round each iris centre: (|dx|, below, above) or (inner, outer,
+              below, above) in working units
+  eye_grow    the closed-eye box round the measured eye (x, y factors)
+  eye_mirror  average the two eye boxes into a mirrored pair (painted faces from image-to-3D are
+              not quite symmetric; the shader and the GLB test expect mirrored boxes)
+  hair_guard  None, or dict(hue=[deg, deg], sat, val): a texel is hair, so a closed eye leaves it
+              as painted, when the HSV of the LINEAR texture colour the shader samples is inside
+              (asset.extras.eyes.hairGuard, figurine.js figGuard; none = Hikari's pink rule)
+  rename      bone renames (source rig -> readable names)
+  add_root    add an unweighted 'root' bone on the floor above this bone (API rigs start at Hips)
+  retarget    Meshy-library humanoid bone -> renamed target bone
+  clips       module in lib/ with build(arm, ...) -> props
+  weapon_kind asset.extras.weaponKind
+"""
+from .rig_names import RENAME as HIKARI_RENAME, RETARGET as HIKARI_RETARGET
+
+
+def _pink_hair(r, g, b):
+    return (r > 185) & (r - g > 45) & (b > g)
+
+
+def _teal_iris(r, g, b):
+    return (g - r > 60) & (b - r > 50)
+
+
+def _blue_hair(r, g, b):
+    # cobalt hair (16, 80, 176), its navy shading (16, 48, 112 .. 16, 16, 48) and the cyan streaks
+    # (48, 208, 240); not the pale blue-grey eye-white shading (208, 208, 240), the goggle lens
+    # or the dark brown lashes
+    return ((b - r > 55) & (b > 1.8 * r) & (b + 20 > g)) | ((b - r > 15) & (b >= g) & (r + g + b < 260))
+
+
+def _amber_iris(r, g, b):
+    # amber-gold irises (187, 116, 36) .. (166, 103, 60); not skin (253, 222, 202), blush or lashes
+    return (r > 120) & (r - b > 80) & (g - b > 30) & (r - g > 15) & (r - g < 120)
+
+
+# Meshy API / animation-library humanoid (v1 names) -> the readable names the game files use
+V1_RENAME = {
+    'Hips': 'hips', 'Spine02': 'spine', 'Spine01': 'spine1', 'Spine': 'chest', 'neck': 'neck', 'Head': 'head',
+    'head_end': 'head_end', 'headfront': 'head_front',
+    'LeftShoulder': 'shoulder_L', 'LeftArm': 'upper_arm_L', 'LeftForeArm': 'forearm_L', 'LeftHand': 'hand_L',
+    'RightShoulder': 'shoulder_R', 'RightArm': 'upper_arm_R', 'RightForeArm': 'forearm_R', 'RightHand': 'hand_R',
+    'LeftUpLeg': 'thigh_L', 'LeftLeg': 'shin_L', 'LeftFoot': 'foot_L', 'LeftToeBase': 'toe_L',
+    'RightUpLeg': 'thigh_R', 'RightLeg': 'shin_R', 'RightFoot': 'foot_R', 'RightToeBase': 'toe_R',
+}
+V1_RETARGET = {k: v for k, v in V1_RENAME.items() if k not in ('head_end', 'headfront')}
+
+PROFILES = {
+    'hikari': dict(
+        normalize=None,
+        face_box=dict(zmin=0.95, zmax=1.36, xmax=0.27, ymax=-0.22),
+        protect=[(0.80, 0.93, 0.15, -0.1, 0.5)],  # neck bow
+        hair=_pink_hair, iris=_teal_iris, eye_front=-0.2, eye_win=(0.14, 0.10, 0.14), eye_grow=(1.12, 1.15),
+        eye_mirror=False, hair_guard=None,
+        rename=HIKARI_RENAME, add_root=None, retarget=HIKARI_RETARGET,
+        library={'Idle_9': 'raw_idle', 'Walking_Woman': 'raw_walk'},
+        clips='clips_hikari', weapon_kind='slash',
+    ),
+    'tenka': dict(
+        # API rig: 0.9 m, Armature scale 0.01, body centre 5.6 cm off x = 0 (side ponytail)
+        normalize=dict(height=1.7, recentre=True),
+        # measured on the normalised figure: front skin z 0.85..1.27, |x| < 0.33; eyes at y ~ -0.21
+        face_box=dict(zmin=0.86, zmax=1.30, xmax=0.31, ymax=-0.12),
+        protect=[(0.72, 0.87, 0.14, -0.08, 0.5)],  # cyan bow tie + collar
+        # her eyes sit closer to the bangs' painted strand outlines than Hikari's: a tighter window
+        # (lash wings included, not the strand outlines between her eyes); a roomier box so the
+        # closed lid covers the painted lashes' corners
+        hair=_blue_hair, iris=_amber_iris, eye_front=-0.12, eye_win=(0.075, 0.12, 0.085, 0.10), eye_grow=(1.2, 1.28),
+        eye_mirror=True,
+        # blue-violet hair + teal streaks: keeps 99.7 % of the hair texels inside the eye boxes as
+        # painted and 0.33 % of the eye / skin texels (scripts/guard_check.py on the bake)
+        hair_guard=dict(hue=[180.0, 260.0], sat=0.6, val=0.12),
+        rename=V1_RENAME, add_root='hips', retarget=V1_RETARGET,
+        library={'Idle_9': 'raw_idle', 'Walking_Woman': 'raw_walk'},
+        clips='clips_tenka', weapon_kind='rifle',
+    ),
+}
+
+
+def get(name):
+    if name not in PROFILES:
+        raise SystemExit(f'unknown profile {name!r} (have: {", ".join(PROFILES)})')
+    return PROFILES[name]
+
+
+def apply_globals(prof):
+    """The lib modules read their figure settings from module globals (Hikari's defaults)."""
+    from . import lowpoly, bake, eyes
+    lowpoly.FACE_BOX = dict(prof['face_box'])
+    lowpoly.PROTECT = list(prof['protect'])
+    bake.HAIR = prof['hair']
+    eyes.HAIR = prof['hair']
+    eyes.IRIS = prof['iris']
+    eyes.FRONT_Y = prof['eye_front']
+    eyes.EYE_WIN = tuple(prof['eye_win'])
+    eyes.EYE_GROW = tuple(prof['eye_grow'])
+    eyes.MIRROR = prof['eye_mirror']
+    eyes.HAIR_GUARD = prof['hair_guard']
+
