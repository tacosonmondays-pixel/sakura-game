{
 "id": "toby",
 "description": "PRIVATE (friends-only alpha): the soundfonts Toby Fox used - EarthBound (SNES rip) + SGM. Fonts are never committed: put them in tools/audio/private/ or point SAKURA_PRIVATE_SF2 at their folder. Missing fonts fall back to cleared role by role, with a warning.",
 "inherit": "cleared",
 "_howto": [
  "1. Copy the two files into tools/audio/private/ (gitignored) or set SAKURA_PRIVATE_SF2=/path/to/folder.",
  "2. If the file names differ, edit soundfonts.eb.path / soundfonts.sgm.path below.",
  "3. List the EarthBound presets: python tools/audio/studio.py presets eb --palette toby",
  "4. Move roles onto EarthBound by editing their entry, e.g. \"music_box\": {\"sf\": \"eb\", \"bank\": 0, \"program\": <n>, ...}. When Kai's Toby palette arrives, paste its role -> preset table here (a converter, tools/audio/kai_import.py, gets written once Kai's file format is known).",
  "5. Re-render with python tools/audio/studio.py render all --palette toby (output stays in tools/audio/build/toby/; nothing ships unless you run ship --palette toby).",
  "6. Round-3 genre roles (tenor_sax ... kick_hard) are mapped to their GM programs in sgm; kick_hard, saw_bass, acid_bass and rhodes repeat cleared's role fx (a child palette replaces whole role entries). The kit roles' kit_map sends fs/sr (GS keys 26/25) to 28/40 because GeneralUser has no samples there; if SGM does, delete those two kit_map entries."
 ],
 "_earthbound_candidates": [
  "chip_pulse12",
  "chip_pulse25",
  "chip_pulse50",
  "chip_triangle",
  "music_box",
  "slap_bass",
  "brass_stab",
  "orch_hit",
  "drums",
  "choir_ahh",
  "steel_drum",
  "organ",
  "epiano",
  "marimba",
  "trumpet",
  "sax"
 ],
 "soundfonts": {
  "eb": {
   "path": "${SAKURA_PRIVATE_SF2}/earthbound.sf2",
   "license": "private, friends-only alpha (owner's waiver)"
  },
  "sgm": {
   "path": "${SAKURA_PRIVATE_SF2}/sgm.sf2",
   "license": "private, friends-only alpha (owner's waiver)"
  }
 },
 "mix": {
  "crush": {
   "bits": 0,
   "mix": 0.0,
   "hold": 1
  },
  "_echo_doc": "Songs set their own echo for the shipped palette; toby changes it relative to that: echo_override keys always win (EarthBound's darker echo filter), echo_scale multiplies the song's values (a shorter, slightly wetter echo).",
  "echo_override": {
   "fir": "dark"
  },
  "echo_scale": {
   "delay_ms": 0.8,
   "feedback": 1.08,
   "volume": 1.1
  },
  "voices": {
   "eb": {},
   "sgm": {
    "lowpass_hz": 11000,
    "brr": {
     "bits": 4,
     "block": 16,
     "mix": 0.12
    }
   }
  }
 },
